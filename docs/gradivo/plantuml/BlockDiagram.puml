@startuml
skinparam defaultTextAlignment left
skinparam linetype ortho
skinparam rectangle {
    BackgroundColor White
    BorderColor Black
    RoundCorner 0
}
skinparam packageStyle rectangle
skinparam arrowColor Black

rectangle "**UPORABNIŠKI VMESNIK (Angular SPA)**\n\n- Javni del (gost)\n- Registracija / prijava\n- Uporabniška nadzorna plošča\n- Urejanje profila\n- Predlogi srečanj\n- Skupinski chat\n- Administratorska nadzorna plošča" as UI

rectangle "**BACKEND API (Node.js / Express)**\n\n- REST API\n- JWT / session avtentikacija\n- avtorizacija uporabnik / admin\n- Socket.io za chat v realnem času" as API

package "**APLIKACIJSKI NIVO**" as AppLayer {

    rectangle "AVTENTIKACIJA & VARNOST\n- registracija\n- prijava / odjava\n- verifikacija e-pošte\n- ponastavitev gesla\n- JWT / session" as Auth

    rectangle "UPRAVLJANJE UPORABNIKOV\n- profil uporabnika\n- interesi\n- lokacija\n- razpoložljivost\n- activeSearch" as Users

    rectangle "PREDLOGI / PAMETNA KOMPONENTA\n- scoring algoritem\n- podobnost interesov\n- geografska bližina\n- časovno ujemanje\n- generiranje predlogov srečanj" as Suggestions

    rectangle "SREČANJA\n- ustvarjanje srečanj\n- prikaz predlogov\n- sprejmi / zavrni\n- potrjena srečanja\n- statusi srečanj" as Meetings

    rectangle "CHAT / SPOROČILA\n- pošiljanje sporočil\n- prikaz sporočil\n- Socket.io sobe" as Chat

    rectangle "OCENE & PRIJAVE\n- ocene srečanj\n- komentarji\n- prijava vedenja" as Feedback

    rectangle "KONTAKT\n- kontaktni obrazec\n- sporočila uporabnikov" as Contact

    rectangle "ADMIN MODUL\n- pregled uporabnikov\n- aktivacija / deaktivacija\n- pregled prijav\n- pregled srečanj\n- analitika sistema" as Admin
}

package "**PODATKOVNA PLAST (MongoDB)**" as DataLayer {
    rectangle "users\n- računi\n- profili\n- interesi\n- lokacija\n- razpoložljivost\n- vloge" as DB_Users

    rectangle "meetings\n- srečanja\n- člani\n- statusi\n- lokacija\n- datum" as DB_Meetings

    rectangle "messages\n- chat sporočila" as DB_Messages

    rectangle "ratings\n- ocene srečanj\n- komentarji" as DB_Ratings

    rectangle "reports\n- prijave vedenja" as DB_Reports

    rectangle "contacts\n- kontaktna sporočila" as DB_Contacts

    rectangle "analytics\n- statistika sistema\n- metrični zapisi" as DB_Analytics
}

rectangle "**ZUNANJE STORITVE**\n\n- Geokodirni API (lokacija → koordinate)\n- E-poštni servis (verifikacija, ponastavitev gesla)" as External

UI --> API
API --> AppLayer
AppLayer --> DataLayer
AppLayer --> External

Suggestions --> Users
Suggestions --> Meetings

Auth --> DB_Users
Users --> DB_Users
Suggestions --> DB_Users
Meetings --> DB_Meetings
Chat --> DB_Messages
Feedback --> DB_Ratings
Feedback --> DB_Reports
Contact --> DB_Contacts
Admin --> DB_Users
Admin --> DB_Meetings
Admin --> DB_Reports
Admin --> DB_Analytics

@enduml