<div class="container">
    <div class="rating-card">
        <div class="rating-header">
            <div class="rating-icon">
                <i class="fas fa-star"></i>
            </div>
            <h1>Oceni srečanje</h1>
            <p>Tvoje mnenje nam veliko pomeni</p>
        </div>
        
        <div class="group-info" id="groupInfo">
            <h3><i class="fas fa-users"></i> <span id="groupName">{{groupName}}</span></h3>
            <span class="group-badge"><i class="fas fa-calendar-check"></i> <span id="groupDate">{{groupDate}}</span></span>
        </div>
        
        <div class="stars-container">
            <span class="stars-label"><i class="fas fa-star"></i> Tvoja ocena</span>
            <div class="stars" id="stars">
                <i class="fas fa-star star" data-value="1"></i>
                <i class="fas fa-star star" data-value="2"></i>
                <i class="fas fa-star star" data-value="3"></i>
                <i class="fas fa-star star" data-value="4"></i>
                <i class="fas fa-star star" data-value="5"></i>
            </div>
        </div>
        
        <div class="comment-section">
            <label><i class="fas fa-comment"></i> Tvoj komentar (neobvezno)</label>
            <textarea id="comment" class="comment-input" placeholder="Kako je bilo srečanje? Kaj ti je bilo všeč? Imaš kakšen predlog za izboljšave?..." maxlength="500"></textarea>
            <div class="char-counter">
                <span id="charCount">0</span>/500 znakov
            </div>
        </div>
        
        <button id="submitRatingBtn" class="btn-primary" disabled>
            <i class="fas fa-paper-plane"></i> Pošlji oceno
        </button>
        
        <div class="divider">
            <span>ali</span>
        </div>
        
        <button id="backBtn" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Nazaj
        </button>
        
        <div id="messageContainer" class="message-container"></div>
    </div>
</div>

<script>
    const groupName = '{{groupName}}';
    const groupDate = '{{groupDate}}';
    const meetingId = '{{meetingId}}';
    
    document.getElementById('groupName').textContent = groupName;
    document.getElementById('groupDate').textContent = groupDate;
    
    let selectedRating = 0;
    let comment = '';
    
    const stars = document.querySelectorAll('.star');
    const commentInput = document.getElementById('comment');
    const charCountSpan = document.getElementById('charCount');
    const submitBtn = document.getElementById('submitRatingBtn');
    const messageContainer = document.getElementById('messageContainer');
    
    stars.forEach(star => {
        star.addEventListener('click', () => {
            const value = parseInt(star.dataset.value);
            selectedRating = value;
            updateStars(value);
            validateForm();
        });
        
        star.addEventListener('mouseenter', () => {
            const value = parseInt(star.dataset.value);
            highlightStars(value);
        });
    });
    
    const starsContainer = document.getElementById('stars');
    starsContainer.addEventListener('mouseleave', () => {
        highlightStars(selectedRating);
    });
    
    function updateStars(rating) {
        stars.forEach(star => {
            const value = parseInt(star.dataset.value);
            if (value <= rating) {
                star.classList.add('selected');
            } else {
                star.classList.remove('selected');
            }
        });
    }
    
    function highlightStars(rating) {
        stars.forEach(star => {
            const value = parseInt(star.dataset.value);
            if (value <= rating && rating > 0) {
                star.style.color = '#fbbf24';
            } else {
                star.style.color = '#334155';
            }
        });
        
        setTimeout(() => {
            stars.forEach(star => {
                const value = parseInt(star.dataset.value);
                if (value <= selectedRating && selectedRating > 0) {
                    star.style.color = '#fbbf24';
                } else {
                    star.style.color = '#334155';
                }
            });
        }, 200);
    }
    
    commentInput.addEventListener('input', () => {
        const length = commentInput.value.length;
        charCountSpan.textContent = length;
        comment = commentInput.value;
        validateForm();
    });
    
    function validateForm() {
        if (selectedRating > 0) {
            submitBtn.disabled = false;
        } else {
            submitBtn.disabled = true;
        }
    }
    
    function showMessage(message, type) {
        messageContainer.innerHTML = `
            <div class="message-${type}">
                ${message}
            </div>
        `;
        
        if (type === 'error') {
            setTimeout(() => {
                if (messageContainer.innerHTML.includes(message)) {
                    messageContainer.innerHTML = '';
                }
            }, 5000);
        }
    }
    
    function clearMessage() {
        messageContainer.innerHTML = '';
    }
    
    function showSuccessModal() {
        const modal = document.createElement('div');
        modal.className = 'modal-overlay';
        modal.innerHTML = `
            <div class="modal-content">
                <i class="fas fa-check-circle"></i>
                <h3>Ocena uspešno shranjena!</h3>
                <p>Hvala, ker si si vzela čas in ocenila srečanje. Tvoje mnenje nam veliko pomeni!</p>
                <div class="modal-actions">
                    <button class="btn-primary" id="closeModalBtn">
                        <i class="fas fa-home"></i> Nazaj na domačo stran
                    </button>
                </div>
            </div>
        `;
        
        document.body.appendChild(modal);
        
        const closeBtn = modal.querySelector('#closeModalBtn');
        closeBtn.addEventListener('click', () => {
            modal.remove();
            window.location.href = '/';
        });
        
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.remove();
                window.location.href = '/';
            }
        });
    }
    
    document.getElementById('submitRatingBtn').addEventListener('click', () => {
        clearMessage();
        
        if (selectedRating === 0) {
            showMessage('Prosimo, izberite oceno (1-5 zvezdic).', 'error');
            document.querySelector('.stars-container').classList.add('shake');
            setTimeout(() => document.querySelector('.stars-container').classList.remove('shake'), 300);
            return;
        }
        
        submitBtn.disabled = true;
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Shranjevanje...';
        
        setTimeout(() => {
            showSuccessModal();
            submitBtn.innerHTML = originalText;
        }, 1000);
    });
    
    document.getElementById('backBtn').addEventListener('click', () => {
        window.location.href = '/';
    });
    
    updateStars(0);
</script>