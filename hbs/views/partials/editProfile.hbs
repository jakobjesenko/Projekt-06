<div class="register-wizard">
    <div class="wizard-container">
        <div class="step-header">
            <i class="fas fa-user-edit"></i>
            <h2>Uredi profil</h2>
            <p>Spremeni svoje podatke</p>
        </div>
        
        <form id="editProfileForm">
            <!-- Osebni podatki -->
            <div class="form-row">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> Ime</label>
                    <input type="text" name="firstName" value="{{user.firstName}}" class="form-input" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-user-tag"></i> Priimek</label>
                    <input type="text" name="lastName" value="{{user.lastName}}" class="form-input" required>
                </div>
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-at"></i> Uporabniško ime</label>
                <input type="text" name="username" value="{{user.username}}" class="form-input" required>
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-calendar-alt"></i> Datum rojstva</label>
                <input type="date" name="birthday" value="{{formatDate user.birthday}}" class="form-input" required id="birthday">
                <small class="form-hint">Stari morate biti vsaj 16 let.</small>
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-envelope"></i> E-pošta</label>
                <input type="email" name="email" value="{{user.email}}" class="form-input" required>
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-lock"></i> Novo geslo (pusti prazno če ne želiš spremeniti)</label>
                <input type="password" name="password" placeholder="••••••••" class="form-input">
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-lock"></i> Potrdi novo geslo</label>
                <input type="password" name="passwordConfirm" placeholder="••••••••" class="form-input">
            </div>
            
            <!-- Lokacija z zemljevidom -->
            <div class="form-group">
                <label><i class="fas fa-location-dot"></i> Tvoja lokacija (klikni na zemljevid)</label>
                <div id="map" style="height: 300px; width: 100%; border-radius: 20px; margin-bottom: 1rem;"></div>
                
                <input type="hidden" name="locationLat" id="locationLat" value="{{user.location.lat}}">
                <input type="hidden" name="locationLng" id="locationLng" value="{{user.location.lng}}">
                <input type="hidden" name="locationRadius" id="locationRadius" value="{{user.location.radius}}">
                
                <div class="radius-control">
                    <label><i class="fas fa-expand-alt"></i> Radij iskanja: <span id="radiusValue">{{user.location.radius}}</span> km</label>
                    <input type="range" id="radiusSlider" min="1" max="50" step="1" value="{{user.location.radius}}">
                    <div class="radius-hint">
                        <i class="fas fa-info-circle"></i> Krog prikazuje območje, kjer si pripravljen/a potovati.
                    </div>
                </div>
                <div id="locationStatus" class="location-status"></div>
            </div>
            
            <!-- Interesi -->
            <div class="form-group">
                <label><i class="fas fa-heart"></i> Interesi (izberi vsaj 3)</label>
                <div class="interests-grid" id="interestsGrid">
                    {{#each interestsMaster}}
                    <label class="interest-chip" data-value="{{this.name}}">
                        <i class="fas {{this.icon}}"></i> {{this.name}}
                    </label>
                    {{/each}}
                </div>
                <div id="interestsError" class="error-message" style="display: none;">Izberi vsaj 3 interese</div>
            </div>
            
            <!-- Razpoložljivost -->
            <div class="form-group">
                <label><i class="fas fa-calendar-week"></i> Kdaj si prost/a?</label>
                <div class="quick-buttons">
                    <button type="button" class="quick-btn" id="quickWeeknights">🌙 Po delavnikih (pon–pet zvečer)</button>
                    <button type="button" class="quick-btn" id="quickWeekends">🎉 Vikendi (sob, ned cel dan)</button>
                    <button type="button" class="quick-btn" id="quickClear">🗑 Počisti vse</button>
                </div>
                
                <div class="calendar-grid">
                    <div class="calendar-header"></div>
                    {{#each weekdays}}
                    <div class="calendar-header day-header">{{this}}</div>
                    {{/each}}
                    
                    {{#each dayPartsWithTimes}}
                    <div class="time-label">
                        {{this.label}}<br>
                        <span class="time-range">{{this.range}}</span>
                    </div>
                    {{#each ../weekdays}}
                    <label class="calendar-slot" data-day="{{this}}" data-part="{{../this.key}}">
                        <input type="checkbox" name="availability" value="{{this}}__{{../this.key}}" style="display: none;">
                        <span class="slot-time">{{../this.range}}</span>
                    </label>
                    {{/each}}
                    {{/each}}
                </div>
            </div>
            
            <div class="wizard-nav">
                <button type="button" class="btn-secondary" onclick="window.location.href='/dashboard'">Prekliči</button>
                <button type="submit" class="btn-success">Shrani spremembe <i class="fas fa-save"></i></button>
            </div>
        </form>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
    const dayPartsWithTimes = [
        { key: "jutro", label: "Zjutraj", range: "6:00 - 9:00" },
        { key: "dopoldan", label: "Dopoldan", range: "9:00 - 12:00" },
        { key: "popoldan", label: "Popoldan", range: "12:00 - 19:00" },
        { key: "zvecer", label: "Zvečer", range: "19:00 - 00:00" }
    ];
    
    // Trenutni interesi uporabnika
    const currentInterests = {{{json user.interests}}};
    const selectedInterests = new Set(currentInterests || []);
    
    // Trenutna razpoložljivost
    const currentAvailability = {{{json user.availability}}};
    
    // Inicializacija interesov
    const interestChips = document.querySelectorAll('.interest-chip');
    
    function updateInterestSelection() {
        interestChips.forEach(chip => {
            const value = chip.getAttribute('data-value');
            if (selectedInterests.has(value)) {
                chip.classList.add('selected');
            } else {
                chip.classList.remove('selected');
            }
        });
    }
    
    interestChips.forEach(chip => {
        chip.addEventListener('click', function() {
            const value = this.getAttribute('data-value');
            if (selectedInterests.has(value)) {
                selectedInterests.delete(value);
            } else {
                selectedInterests.add(value);
            }
            updateInterestSelection();
            
            const errorDiv = document.getElementById('interestsError');
            if (selectedInterests.size >= 3) {
                errorDiv.style.display = 'none';
            }
        });
    });
    
    updateInterestSelection();
    
    // Koledar
    const calendarSlots = document.querySelectorAll('.calendar-slot');
    
    function updateCalendarSlot(slot) {
        const checkbox = slot.querySelector('input[type="checkbox"]');
        if (checkbox.checked) {
            slot.classList.add('selected-slot');
        } else {
            slot.classList.remove('selected-slot');
        }
    }
    
    // Nastavi obstoječe termine
    calendarSlots.forEach(slot => {
        const checkbox = slot.querySelector('input[type="checkbox"]');
        const value = checkbox.value;
        if (currentAvailability && currentAvailability.includes(value)) {
            checkbox.checked = true;
            updateCalendarSlot(slot);
        }
        
        slot.addEventListener('click', function(e) {
            if (e.target !== checkbox) {
                checkbox.checked = !checkbox.checked;
                updateCalendarSlot(slot);
            }
        });
    });
    
    // Hitri gumbi
    function setQuickWeeknights() {
        calendarSlots.forEach(slot => {
            const day = slot.getAttribute('data-day');
            const part = slot.getAttribute('data-part');
            const weekdays = ['Pon', 'Tor', 'Sre', 'Čet', 'Pet'];
            const checkbox = slot.querySelector('input[type="checkbox"]');
            checkbox.checked = weekdays.includes(day) && part === 'zvecer';
            updateCalendarSlot(slot);
        });
    }
    
    function setQuickWeekends() {
        calendarSlots.forEach(slot => {
            const day = slot.getAttribute('data-day');
            const weekendDays = ['Sob', 'Ned'];
            const checkbox = slot.querySelector('input[type="checkbox"]');
            checkbox.checked = weekendDays.includes(day);
            updateCalendarSlot(slot);
        });
    }
    
    function clearAvailability() {
        calendarSlots.forEach(slot => {
            const checkbox = slot.querySelector('input[type="checkbox"]');
            checkbox.checked = false;
            updateCalendarSlot(slot);
        });
    }
    
    document.getElementById('quickWeeknights')?.addEventListener('click', setQuickWeeknights);
    document.getElementById('quickWeekends')?.addEventListener('click', setQuickWeekends);
    document.getElementById('quickClear')?.addEventListener('click', clearAvailability);
    
    // Zemljevid
    let map, circle, marker;
    
    function initMap() {
        const defaultLat = parseFloat(document.getElementById('locationLat').value) || 46.0569;
        const defaultLng = parseFloat(document.getElementById('locationLng').value) || 14.5058;
        
        map = L.map('map').setView([defaultLat, defaultLng], 13);
        
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);
        
        if (defaultLat && defaultLng && defaultLat !== 46.0569) {
            const radiusKm = parseFloat(document.getElementById('radiusSlider').value);
            marker = L.marker([defaultLat, defaultLng]).addTo(map);
            circle = L.circle([defaultLat, defaultLng], {
                color: '#818cf8',
                fillColor: '#c084fc',
                fillOpacity: 0.2,
                radius: radiusKm * 1000
            }).addTo(map);
            marker.bindPopup(`📍 Tvoja lokacija<br>📡 Radij: ${radiusKm} km`).openPopup();
        }
        
        map.on('click', function(e) {
            const lat = e.latlng.lat;
            const lng = e.latlng.lng;
            
            document.getElementById('locationLat').value = lat;
            document.getElementById('locationLng').value = lng;
            
            if (marker) map.removeLayer(marker);
            if (circle) map.removeLayer(circle);
            
            marker = L.marker([lat, lng]).addTo(map);
            const radiusKm = parseFloat(document.getElementById('radiusSlider').value);
            circle = L.circle([lat, lng], {
                color: '#818cf8',
                fillColor: '#c084fc',
                fillOpacity: 0.2,
                radius: radiusKm * 1000
            }).addTo(map);
            
            const locationStatus = document.getElementById('locationStatus');
            locationStatus.innerHTML = `<i class="fas fa-check-circle" style="color: #10b981;"></i> Lokacija posodobljena! Radij: ${radiusKm} km`;
            marker.bindPopup(`📍 Nova lokacija<br>📡 Radij: ${radiusKm} km`).openPopup();
        });
    }
    
    const radiusSlider = document.getElementById('radiusSlider');
    const radiusValue = document.getElementById('radiusValue');
    
    radiusSlider.addEventListener('input', function() {
        const newRadius = parseFloat(this.value);
        radiusValue.innerText = newRadius;
        document.getElementById('locationRadius').value = newRadius;
        
        if (circle && document.getElementById('locationLat').value) {
            const center = circle.getLatLng();
            circle.setRadius(newRadius * 1000);
            if (marker) {
                marker.bindPopup(`📍 Tvoja lokacija<br>📡 Radij: ${newRadius} km`).openPopup();
            }
        }
    });
    
    // Submit form
    const form = document.getElementById('editProfileForm');
    
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const password = document.querySelector('input[name="password"]').value;
        const passwordConfirm = document.querySelector('input[name="passwordConfirm"]').value;
        
        if (password && password !== passwordConfirm) {
            alert('Gesli se ne ujemata!');
            return;
        }
        
        if (selectedInterests.size < 3) {
            document.getElementById('interestsError').style.display = 'block';
            return;
        }
        
        // Preveri starost
        const birthday = document.querySelector('input[name="birthday"]').value;
        const birthDate = new Date(birthday);
        const today = new Date();
        let age = today.getFullYear() - birthDate.getFullYear();
        const monthDiff = today.getMonth() - birthDate.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }
        if (age < 16) {
            alert('Stari morate biti vsaj 16 let.');
            return;
        }
        
        const availabilitySelected = Array.from(document.querySelectorAll('input[name="availability"]:checked')).map(cb => cb.value);
        
        const formData = {
            firstName: document.querySelector('input[name="firstName"]').value.trim(),
            lastName: document.querySelector('input[name="lastName"]').value.trim(),
            username: document.querySelector('input[name="username"]').value.trim(),
            birthday: birthday,
            email: document.querySelector('input[name="email"]').value.trim(),
            password: password,
            interests: Array.from(selectedInterests),
            availability: availabilitySelected,
            location: {
                lat: parseFloat(document.getElementById('locationLat').value),
                lng: parseFloat(document.getElementById('locationLng').value),
                radius: parseInt(document.getElementById('locationRadius').value)
            }
        };
        
        console.log("Sending update:", formData);
        
        try {
            const response = await fetch(`/api/auth/profile/{{user._id}}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            
            const data = await response.json();
            console.log("Response:", data);
            
            if (response.ok) {
                alert('Profil uspešno posodobljen!');
                window.location.href = '/dashboard';
            } else {
                alert('Napaka: ' + (data.message || 'Posodobitev ni uspela'));
            }
        } catch (err) {
            console.error("Error:", err);
            alert('Napaka: ' + err.message);
        }
    });
    
    document.addEventListener('DOMContentLoaded', function() {
        initMap();
        
        // Nastavi max datum za rojstni dan (16 let nazaj)
        const birthdayInput = document.getElementById('birthday');
        if (birthdayInput) {
            const today = new Date();
            const maxDate = new Date(today.getFullYear() - 16, today.getMonth(), today.getDate());
            birthdayInput.setAttribute('max', maxDate.toISOString().split('T')[0]);
        }
    });
</script>

<style>
    .location-status {
        margin-top: 10px;
        padding: 8px;
        border-radius: 12px;
        text-align: center;
        font-size: 0.85rem;
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }
    .radius-control {
        margin-top: 10px;
        padding: 10px;
        background: #1e293b;
        border-radius: 16px;
    }
    .radius-control label {
        display: block;
        margin-bottom: 8px;
        color: #e2e8f0;
    }
    #radiusSlider {
        width: 100%;
        height: 6px;
        -webkit-appearance: none;
        background: #334155;
        border-radius: 3px;
    }
    #radiusSlider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        background: linear-gradient(135deg, #818cf8, #c084fc);
        border-radius: 50%;
        cursor: pointer;
    }
    .calendar-grid {
        display: grid;
        grid-template-columns: 100px repeat(7, 1fr);
        gap: 5px;
        margin-top: 10px;
        background: #1e293b;
        padding: 10px;
        border-radius: 16px;
        overflow-x: auto;
    }
    .calendar-slot {
        background: #0f172a;
        border-radius: 8px;
        padding: 8px;
        text-align: center;
        cursor: pointer;
        border: 1px solid #334155;
        font-size: 0.7rem;
    }
    .calendar-slot.selected-slot {
        background: linear-gradient(135deg, #818cf8, #c084fc);
        color: white;
    }
    .time-label {
        font-size: 0.75rem;
        text-align: center;
        padding: 8px;
        background: rgba(129, 140, 248, 0.1);
        border-radius: 8px;
    }
    .day-header {
        text-align: center;
        padding: 8px;
        font-weight: bold;
        color: #a78bfa;
    }
    .quick-buttons {
        display: flex;
        gap: 10px;
        margin: 10px 0;
        flex-wrap: wrap;
    }
    .quick-btn {
        background: #1e293b;
        border: 1px solid #334155;
        padding: 6px 12px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.8rem;
        color: #cbd5e1;
    }
    .quick-btn:hover {
        background: #334155;
        border-color: #a78bfa;
    }
    .interest-chip {
        background: #1e293b;
        padding: 8px 12px;
        border-radius: 40px;
        cursor: pointer;
        display: inline-block;
        margin: 4px;
        border: 1px solid #334155;
        color: #cbd5e1;
    }
    .interest-chip.selected {
        background: linear-gradient(135deg, #818cf8, #c084fc);
        color: white;
        border-color: #a78bfa;
    }
    .interests-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 10px 0;
    }
    .error-message {
        color: #ef4444;
        font-size: 0.8rem;
        margin-top: 5px;
        text-align: center;
    }
</style>