<div class="login-container">
    <div class="register-wizard">
        <div class="step-header">
            <i class="fas fa-key"></i>
            <h2>Pozabljeno geslo</h2>
            <p>Vnesite svoj e-poštni naslov za ponastavitev gesla</p>
        </div>
        
        <form action="/api/auth/forgot-password" method="POST">
            <div class="form-group">
                <label><i class="fas fa-envelope"></i> E-pošta</label>
                <input type="email" name="email" placeholder="ana@email.com" class="form-input" required>
            </div>
            <button type="submit" class="btn-primary btn-large" style="width: 100%;">
                <i class="fas fa-paper-plane"></i> Pošlji povezavo
            </button>
        </form>
        
        <div class="wizard-nav" style="justify-content: center; margin-top: 1rem;">
            <button class="btn-secondary" onclick="window.location.href='/login'">Nazaj na prijavo</button>
        </div>
    </div>
</div>