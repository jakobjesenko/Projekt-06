<div class="container">
    <div class="reset-card">
        <div class="reset-header">
            <div class="reset-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Ponastavitev gesla</h1>
            <p>Vnesite in potrdite novo geslo</p>
        </div>
        
        <form id="resetPasswordForm">
            <div class="form-group">
                <label><i class="fas fa-key"></i> Novo geslo</label>
                <div class="input-wrapper">
                    <input type="password" id="newPassword" class="form-input" placeholder="Vnesite novo geslo">
                    <i class="fas fa-eye-slash toggle-password" data-target="newPassword"></i>
                </div>
                <div class="password-strength" id="passwordStrength">
                    <div class="strength-bar">
                        <div class="strength-segment" id="strength1"></div>
                        <div class="strength-segment" id="strength2"></div>
                        <div class="strength-segment" id="strength3"></div>
                    </div>
                    <div class="strength-text" id="strengthText"></div>
                </div>
                <div id="passwordValidation" class="validation-message"></div>
            </div>
            
            <div class="form-group">
                <label><i class="fas fa-check-circle"></i> Potrdite geslo</label>
                <div class="input-wrapper">
                    <input type="password" id="confirmPassword" class="form-input" placeholder="Ponovno vnesite geslo">
                    <i class="fas fa-eye-slash toggle-password" data-target="confirmPassword"></i>
                </div>
                <div id="confirmValidation" class="validation-message"></div>
            </div>
            
            <button type="submit" class="btn-primary" id="submitBtn">
                <i class="fas fa-save"></i> Ponastavi geslo
            </button>
        </form>
        
        <div class="divider">
            <span>ali</span>
        </div>
        
        <button class="btn-secondary" id="backToLoginBtn">
            <i class="fas fa-arrow-left"></i> Nazaj na prijavo
        </button>
        
        <div id="messageContainer" class="message-container"></div>
    </div>
</div>

<script>
    const newPasswordInput = document.getElementById('newPassword');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const submitBtn = document.getElementById('submitBtn');
    const passwordValidation = document.getElementById('passwordValidation');
    const confirmValidation = document.getElementById('confirmValidation');
    const messageContainer = document.getElementById('messageContainer');
    
    const strength1 = document.getElementById('strength1');
    const strength2 = document.getElementById('strength2');
    const strength3 = document.getElementById('strength3');
    const strengthText = document.getElementById('strengthText');
    
    const email = '{{email}}';
    
    document.querySelectorAll('.toggle-password').forEach(icon => {
        icon.addEventListener('click', function() {
            const targetId = this.dataset.target;
            const input = document.getElementById(targetId);
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });
    });
    
    function checkPasswordStrength(password) {
        let strength = 0;
        
        if (password.length === 0) {
            return { score: 0, text: '' };
        }
        
        if (password.length >= 8) strength++;
        if (password.length >= 12) strength++;
        if (/\d/.test(password)) strength++;
        if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
        if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) strength++;
        
        let score = 0;
        if (strength >= 4) score = 3;
        else if (strength >= 2) score = 2;
        else if (strength >= 1) score = 1;
        
        let text = '';
        if (score === 1) text = 'Šibko geslo';
        else if (score === 2) text = 'Srednje močno geslo';
        else if (score === 3) text = 'Močno geslo ✓';
        
        return { score, text };
    }
    
    function updateStrengthMeter(password) {
        const { score, text } = checkPasswordStrength(password);
        
        strength1.className = 'strength-segment';
        strength2.className = 'strength-segment';
        strength3.className = 'strength-segment';
        
        if (score === 1) {
            strength1.classList.add('weak');
            strengthText.textContent = text;
            strengthText.style.color = '#ef4444';
        } else if (score === 2) {
            strength1.classList.add('medium');
            strength2.classList.add('medium');
            strengthText.textContent = text;
            strengthText.style.color = '#fbbf24';
        } else if (score === 3) {
            strength1.classList.add('strong');
            strength2.classList.add('strong');
            strength3.classList.add('strong');
            strengthText.textContent = text;
            strengthText.style.color = '#10b981';
        } else {
            strengthText.textContent = '';
        }
    }
    
    function validatePassword(password) {
        const errors = [];
        if (password.length < 8) errors.push('Geslo mora imeti vsaj 8 znakov');
        if (!/\d/.test(password)) errors.push('Geslo mora vsebovati vsaj eno številko');
        if (!/[a-z]/.test(password) || !/[A-Z]/.test(password)) errors.push('Geslo mora vsebovati vsaj eno veliko in eno malo črko');
        return errors;
    }
    
    function validateConfirm(password, confirm) {
        if (confirm && password !== confirm) return 'Gesli se ne ujemata';
        return null;
    }
    
    newPasswordInput.addEventListener('input', () => {
        const password = newPasswordInput.value;
        const confirm = confirmPasswordInput.value;
        
        updateStrengthMeter(password);
        
        const errors = validatePassword(password);
        if (password.length > 0 && errors.length > 0) {
            passwordValidation.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${errors[0]}`;
            passwordValidation.className = 'validation-message error';
        } else if (password.length > 0 && errors.length === 0) {
            passwordValidation.innerHTML = '<i class="fas fa-check-circle"></i> Geslo je veljavno';
            passwordValidation.className = 'validation-message success';
        } else {
            passwordValidation.innerHTML = '';
        }
        
        if (confirm) {
            const confirmError = validateConfirm(password, confirm);
            if (confirmError) {
                confirmValidation.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${confirmError}`;
                confirmValidation.className = 'validation-message error';
            } else {
                confirmValidation.innerHTML = '<i class="fas fa-check-circle"></i> Gesli se ujemata';
                confirmValidation.className = 'validation-message success';
            }
        } else {
            confirmValidation.innerHTML = '';
        }
        
        const isValid = password.length >= 8 && 
                       /\d/.test(password) && 
                       /[a-z]/.test(password) && 
                       /[A-Z]/.test(password) &&
                       password === confirm;
        submitBtn.disabled = !isValid;
    });
    
    confirmPasswordInput.addEventListener('input', () => {
        const password = newPasswordInput.value;
        const confirm = confirmPasswordInput.value;
        
        const confirmError = validateConfirm(password, confirm);
        if (confirm && confirmError) {
            confirmValidation.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${confirmError}`;
            confirmValidation.className = 'validation-message error';
        } else if (confirm && !confirmError) {
            confirmValidation.innerHTML = '<i class="fas fa-check-circle"></i> Gesli se ujemata';
            confirmValidation.className = 'validation-message success';
        } else {
            confirmValidation.innerHTML = '';
        }
        
        const isValid = password.length >= 8 && 
                       /\d/.test(password) && 
                       /[a-z]/.test(password) && 
                       /[A-Z]/.test(password) &&
                       password === confirm;
        submitBtn.disabled = !isValid;
    });
    
    document.getElementById('resetPasswordForm').addEventListener('submit', (e) => {
        e.preventDefault();
        
        const newPassword = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        const errors = validatePassword(newPassword);
        if (errors.length > 0) {
            showMessage(errors[0], 'error');
            newPasswordInput.classList.add('shake');
            setTimeout(() => newPasswordInput.classList.remove('shake'), 300);
            return;
        }
        
        if (newPassword !== confirmPassword) {
            showMessage('Gesli se ne ujemata', 'error');
            confirmPasswordInput.classList.add('shake');
            setTimeout(() => confirmPasswordInput.classList.remove('shake'), 300);
            return;
        }
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ponastavljanje...';
        
        setTimeout(() => {
            showMessage(`
                <i class="fas fa-check-circle"></i> 
                Geslo je bilo uspešno ponastavljeno!<br>
                <small>Sedaj se lahko prijavite z novim geslom.</small>
            `, 'success');
            
            submitBtn.innerHTML = '<i class="fas fa-check"></i> Geslo ponastavljeno!';
            
            newPasswordInput.value = '';
            confirmPasswordInput.value = '';
            passwordValidation.innerHTML = '';
            confirmValidation.innerHTML = '';
            updateStrengthMeter('');
            
            setTimeout(() => {
                window.location.href = '/login';
            }, 3000);
        }, 1500);
    });
    
    function showMessage(message, type) {
        messageContainer.innerHTML = `
            <div class="message-${type}">
                ${message}
            </div>
        `;
        
        if (type === 'error') {
            setTimeout(() => {
                if (messageContainer.innerHTML.includes(message)) {
                    messageContainer.innerHTML = '';
                }
            }, 5000);
        }
    }
    
    document.getElementById('backToLoginBtn').addEventListener('click', () => {
        window.location.href = '/login';
    });
    
    submitBtn.disabled = true;
    
    if (email && email !== 'uporabnik') {
        const headerP = document.querySelector('.reset-header p');
        headerP.innerHTML = `Ponastavitev gesla za: <strong>${decodeURIComponent(email)}</strong>`;
    }
</script>