<div class="dashboard-grid">
    <!-- Sidebar -->
    <div class="dashboard-sidebar">
        <div class="user-card panel">
            <div class="user-avatar-large">
                <div class="avatar-initials">{{user.username.charAt 0}}</div>
            </div>
            <h3>{{user.username}}</h3>
            <p class="user-name">{{user.firstName}} {{user.lastName}}</p>
            <p class="user-email">{{user.email}}</p>
            <p class="user-age"><i class="fas fa-calendar-alt"></i> {{user.age}} let</p>
            
            <!-- Zemljevid za lokacijo -->
            <div class="user-location-map">
                <div id="userMap" style="height: 200px; width: 100%; border-radius: 16px; margin: 10px 0;"></div>
                <div class="location-info">
                    <i class="fas fa-map-marker-alt"></i> 
                    <span>Radij: {{user.location.radius}} km</span>
                </div>
            </div>
            
            <div class="search-status" id="searchStatus">
                {{#if user.activeSearch}}
                    <i class="fas fa-bell"></i> Iskanje aktivno
                {{else}}
                    <i class="fas fa-bell-slash"></i> Iskanje ni aktivno
                {{/if}}
            </div>
            <form id="activateSearchForm">
                <button type="submit" class="btn-primary btn-full">
                    <i class="fas fa-search"></i> Aktiviraj iskanje
                </button>
            </form>
            <button onclick="window.location.href='/profile/edit'" class="btn-secondary btn-full" style="margin-top: 0.5rem;">
                <i class="fas fa-edit"></i> Uredi profil
            </button>
        </div>
        
        <div class="interests-card panel">
            <h4><i class="fas fa-heart"></i> Moji interesi</h4>
            <div class="interests-tags">
                {{#each user.interests}}
                    <span class="interest-tag">{{this}}</span>
                {{/each}}
            </div>
        </div>
        
        <div class="availability-card panel">
            <h4><i class="fas fa-clock"></i> Razpoložljivost</h4>
            <div class="availability-table">
                <table class="avail-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Pon</th>
                            <th>Tor</th>
                            <th>Sre</th>
                            <th>Čet</th>
                            <th>Pet</th>
                            <th>Sob</th>
                            <th>Ned</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="time-label-cell">Zjutraj<br><span class="time-range">6-9</span></td>
                            <td class="avail-cell" data-day="Pon" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Tor" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Sre" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Čet" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Pet" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Sob" data-part="jutro"></td>
                            <td class="avail-cell" data-day="Ned" data-part="jutro"></td>
                        </tr>
                        <tr>
                            <td class="time-label-cell">Dopoldan<br><span class="time-range">9-12</span></td>
                            <td class="avail-cell" data-day="Pon" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Tor" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Sre" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Čet" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Pet" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Sob" data-part="dopoldan"></td>
                            <td class="avail-cell" data-day="Ned" data-part="dopoldan"></td>
                        </tr>
                        <tr>
                            <td class="time-label-cell">Popoldan<br><span class="time-range">12-19</span></td>
                            <td class="avail-cell" data-day="Pon" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Tor" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Sre" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Čet" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Pet" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Sob" data-part="popoldan"></td>
                            <td class="avail-cell" data-day="Ned" data-part="popoldan"></td>
                        </tr>
                        <tr>
                            <td class="time-label-cell">Zvečer<br><span class="time-range">19-00</span></td>
                            <td class="avail-cell" data-day="Pon" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Tor" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Sre" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Čet" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Pet" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Sob" data-part="zvecer"></td>
                            <td class="avail-cell" data-day="Ned" data-part="zvecer"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="dashboard-main">
        <div class="suggestions-header">
            <h2><i class="fas fa-users"></i> Predlogi skupin</h2>
            <p>Na podlagi tvojih interesov in razpoložljivosti</p>
        </div>
        <div id="groupSuggestionsContainer" class="suggestions-grid">
            {{#each suggestions}}
                <div class="group-card">
                    <div class="group-header">
                        <span class="group-badge">{{name}}</span>
                        <span class="match-badge">{{matchScore}}% ujemanja</span>
                    </div>
                    <div class="group-members">
                        {{#each members}}
                            <span class="member-chip">{{this}}</span>
                        {{/each}}
                    </div>
                    <div class="group-details">
                        <span><i class="fas fa-tag"></i> Skupni interesi: {{interests.join ", "}}</span>
                    </div>
                    <div class="group-details">
                        <span><i class="fas fa-clock"></i> {{time}}</span>
                        <span><i class="fas fa-map-marker-alt"></i> {{location}}</span>
                    </div>
                    <div class="group-actions">
                        <form action="/api/meetings/confirm" method="POST">
                            <input type="hidden" name="userId" value="{{../user._id}}">
                            <input type="hidden" name="groupName" value="{{name}}">
                            <input type="hidden" name="members" value="{{json members}}">
                            <input type="hidden" name="location" value="{{location}}">
                            <input type="hidden" name="dateTime" value="{{time}}">
                            <button type="submit" class="btn-primary"><i class="fas fa-check-circle"></i> Sprejmem predlog</button>
                        </form>
                        <button class="btn-secondary" onclick="alert('Klepet bo na voljo kmalu!')"><i class="fas fa-comment-dots"></i> Pogovor</button>
                    </div>
                </div>
            {{else}}
                <div class="group-card" style="text-align: center; padding: 3rem;">
                    <i class="fas fa-search" style="font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
                    <h3>Trenutno ni predlogov</h3>
                    <p style="color: #64748b;">Aktiviraj iskanje za prejemanje predlogov skupin.</p>
                </div>
            {{/each}}
        </div>
        
        <!-- Confirmed Meetings -->
        <div class="confirmed-meetings-section" style="margin-top: 2rem;">
            <div class="suggestions-header">
                <h2><i class="fas fa-check-circle"></i> Moja potrjena srečanja</h2>
                <p>Srečanja, ki si jih potrdil/a</p>
            </div>
            <div class="suggestions-grid">
                {{#each confirmedMeetings}}
                    <div class="group-card">
                        <div class="group-header">
                            <span class="group-badge">{{groupName}}</span>
                            <span class="confirmed-badge">Potrjeno</span>
                        </div>
                        <div class="meeting-participants">
                            <strong><i class="fas fa-users"></i> Udeleženci:</strong><br>
                            {{#each members}}
                                <span class="participant-name">{{this}}</span>
                            {{/each}}
                        </div>
                        <div class="group-details">
                            <span><i class="fas fa-clock"></i> {{dateTime}}</span>
                            <span><i class="fas fa-map-marker-alt"></i> {{location}}</span>
                        </div>
                    </div>
                {{else}}
                    <div class="group-card" style="text-align: center; padding: 3rem;">
                        <i class="fas fa-clock" style="font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
                        <h3>Ni potrjenih srečanj</h3>
                        <p style="color: #64748b;">Ko sprejmeš predlog skupine, se bo prikazal tukaj.</p>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
    // Razpoložljivost uporabnika (iz serverja)
    const userAvailability = {{{json user.availability}}};
    
    // Obarvaj celice v tabeli razpoložljivosti
    function markAvailability() {
        const cells = document.querySelectorAll('.avail-cell');
        console.log("Cells found:", cells.length);
        console.log("User availability:", userAvailability);
        
        cells.forEach(cell => {
            const day = cell.getAttribute('data-day');
            const part = cell.getAttribute('data-part');
            const value = `${day}__${part}`;
            
            if (userAvailability && userAvailability.includes(value)) {
                cell.classList.add('available');
                cell.innerHTML = '✓';
            } else {
                cell.innerHTML = '';
            }
        });
    }
    
    // Zemljevid za uporabnikovo lokacijo
    function initUserMap() {
        const lat = {{user.location.lat}};
        const lng = {{user.location.lng}};
        const radius = {{user.location.radius}};
        
        console.log("Map init - lat:", lat, "lng:", lng, "radius:", radius);
        
        const mapContainer = document.getElementById('userMap');
        if (!mapContainer) {
            console.error("Map container not found!");
            return;
        }
        
        if (lat && lng && lat !== 0 && lng !== 0 && lat !== null && lng !== null) {
            try {
                const map = L.map('userMap').setView([lat, lng], 12);
                
                L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                    subdomains: 'abcd',
                    maxZoom: 19
                }).addTo(map);
                
                L.marker([lat, lng]).addTo(map).bindPopup('Tvoja lokacija').openPopup();
                
                L.circle([lat, lng], {
                    color: '#818cf8',
                    fillColor: '#c084fc',
                    fillOpacity: 0.2,
                    radius: radius * 1000
                }).addTo(map);
                
                console.log("Map initialized successfully");
            } catch (err) {
                console.error("Map error:", err);
                mapContainer.innerHTML = '<div style="height: 100%; display: flex; align-items: center; justify-content: center; background: #1e293b; border-radius: 16px; color: #64748b;">Napaka pri nalaganju zemljevida</div>';
            }
        } else {
            console.log("No location data");
            mapContainer.innerHTML = '<div style="height: 100%; display: flex; align-items: center; justify-content: center; background: #1e293b; border-radius: 16px; color: #64748b;">Ni izbrane lokacije</div>';
        }
    }
    
    // Aktivacija iskanja
    const activateForm = document.getElementById('activateSearchForm');
    if (activateForm) {
        activateForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const userId = '{{user._id}}';
            
            try {
                const response = await fetch(`/api/auth/activate-search/${userId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                if (response.ok) {
                    location.reload();
                } else {
                    const data = await response.json();
                    alert('Napaka: ' + (data.message || 'Aktivacija ni uspela'));
                }
            } catch (err) {
                alert('Napaka: ' + err.message);
            }
        });
    }
    
    // Inicializacija ko se stran naloži
    document.addEventListener('DOMContentLoaded', function() {
        console.log("DOM loaded, initializing...");
        markAvailability();
        setTimeout(initUserMap, 100);
    });
</script>

