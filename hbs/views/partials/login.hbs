<div class="login-container">
    <div class="register-wizard">
        <div class="step-header">
            <i class="fas fa-sign-in-alt"></i>
            <h2>Prijava</h2>
            <p>Vnesite svoje podatke za prijavo</p>
        </div>
        
        <form action="/api/auth/login" method="POST">
            <div class="form-group">
                <label><i class="fas fa-envelope"></i> E-pošta</label>
                <input type="email" name="email" placeholder="ana@email.com" class="form-input" required>
            </div>
            <div class="form-group">
                <label><i class="fas fa-lock"></i> Geslo</label>
                <input type="password" name="password" placeholder="••••••••" class="form-input" required>
            </div>
            <div style="text-align: right; margin-bottom: 1.5rem;">
                <a href="/forgot-password" style="color: #a78bfa;">Pozabljeno geslo?</a>
            </div>
            <button type="submit" class="btn-primary btn-large" style="width: 100%;">Prijavi se <i class="fas fa-arrow-right"></i></button>
        </form>
        
        <div style="text-align: center; margin-top: 1rem;">
            <span>Nimate računa? </span>
            <a href="/register" style="color: #a78bfa;">Registrirajte se</a>
        </div>
        
        <div class="wizard-nav" style="justify-content: center; margin-top: 1rem;">
            <button class="btn-secondary" onclick="window.location.href='/'">Nazaj</button>
        </div>
    </div>
</div>