<div class="admin-panel">
    <div class="admin-header">
        <h1><i class="fas fa-user-shield"></i> Admin Panel</h1>
    </div>

    <!-- Stats Overview -->
    <div class="admin-stats">
        <div class="stat-card">
            <i class="fas fa-users"></i>
            <div class="stat-number">{{stats.totalUsers}}</div>
            <div class="stat-label">Skupaj uporabnikov</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-calendar-check"></i>
            <div class="stat-number">{{stats.totalMeetings}}</div>
            <div class="stat-label">Skupaj srečanj</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-star"></i>
            <div class="stat-number">{{stats.avgRating}}</div>
            <div class="stat-label">Povprečna ocena</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-search"></i>
            <div class="stat-number">{{stats.activeSearches}}</div>
            <div class="stat-label">Aktivnih iskanj</div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="admin-table-container">
        <h3><i class="fas fa-users"></i> Uporabniki</h3>
        <table class="admin-table">
            <thead>
                <tr><th>ID</th><th>Uporabnik</th><th>E-pošta</th><th>Lokacija</th><th>Status</th><th>Akcije</th></tr>
            </thead>
            <tbody>
                {{#each users}}
                <tr>
                    <td>{{_id}}</td>
                    <td>{{username}}</td>
                    <td>{{email}}</td>
                    <td>{{location}}</td>
                    <td class="{{#if isActive}}status-badge-active{{else}}status-badge-inactive{{/if}}">{{#if isActive}}Aktiven{{else}}Deaktiviran{{/if}}</td>
                    <td>
                        <form action="/api/admin/users/{{_id}}/{{#if isActive}}deactivate{{else}}activate{{/if}}" method="POST" style="display: inline;">
                            <button type="submit" class="{{#if isActive}}deactivate-btn{{else}}activate-btn{{/if}}">
                                {{#if isActive}}<i class="fas fa-ban"></i> Deaktiviraj{{else}}<i class="fas fa-check-circle"></i> Aktiviraj{{/if}}
                            </button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>