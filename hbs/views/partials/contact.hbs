<div class="content-card">
    <h1><i class="fas fa-envelope"></i> Kontaktirajte nas</h1>
    <div class="subtitle">Veseli smo vaših vprašanj, predlogov in povratnih informacij</div>
    
    <form id="contactForm">
        <div class="row">
            <div class="form-group">
                <label><i class="fas fa-user"></i> Ime</label>
                <input type="text" id="firstName" class="form-input" placeholder="Vaše ime" required>
            </div>
            <div class="form-group">
                <label><i class="fas fa-user"></i> Priimek</label>
                <input type="text" id="lastName" class="form-input" placeholder="Vaš priimek" required>
            </div>
        </div>
        
        <div class="form-group">
            <label><i class="fas fa-envelope"></i> E-poštni naslov</label>
            <input type="email" id="email" class="form-input" placeholder="vas@example.com" required>
        </div>
        
        <div class="form-group">
            <label><i class="fas fa-tag"></i> Zadeva</label>
            <input type="text" id="subject" class="form-input" placeholder="Kratek opis vašega vprašanja" required>
        </div>
        
        <div class="form-group">
            <label><i class="fas fa-comment"></i> Sporočilo</label>
            <textarea id="message" class="form-input" placeholder="Podrobno opišite vaše vprašanje ali predlog..." required maxlength="1000"></textarea>
            <div class="char-counter">
                <span id="charCount">0</span>/1000 znakov
            </div>
        </div>
        
        <button type="submit" id="submitBtn" class="btn-primary">
            <i class="fas fa-paper-plane"></i> Pošlji sporočilo
        </button>
    </form>
    
    <div id="messageContainer" class="message-container"></div>
    
    <div class="contact-info">
        <div class="contact-info-item">
            <i class="fas fa-map-marker-alt"></i>
            <span>Ljubljana, Slovenija</span>
        </div>
        <div class="contact-info-item">
            <i class="fas fa-phone"></i>
            <a href="tel:+38612345678">+386 1 234 5678</a>
        </div>
        <div class="contact-info-item">
            <i class="fas fa-envelope"></i>
            <a href="mailto:info@srecajmose.si">info@srecajmose.si</a>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const messageContainer = document.getElementById('messageContainer');
    const charCountSpan = document.getElementById('charCount');
    const messageField = document.getElementById('message');
    
    messageField.addEventListener('input', () => {
        charCountSpan.textContent = messageField.value.length;
    });
    
    function showMessage(message, type) {
        messageContainer.innerHTML = `<div class="message-${type}">${message}</div>`;
        setTimeout(() => {
            if (messageContainer.innerHTML.includes(message)) {
                messageContainer.innerHTML = '';
            }
        }, 5000);
    }
    
    function clearMessage() {
        messageContainer.innerHTML = '';
    }
    
    function showSuccessModal() {
        const modal = document.createElement('div');
        modal.className = 'modal-overlay';
        modal.innerHTML = `
            <div class="modal-content">
                <i class="fas fa-check-circle"></i>
                <h3>Sporočilo uspešno poslano!</h3>
                <p>Hvala, da ste nas kontaktirali. Odgovorili vam bomo v najkrajšem možnem času (običajno v 1-2 delovnih dneh).</p>
                <button class="btn-primary" id="closeModalBtn">V redu</button>
            </div>
        `;
        document.body.appendChild(modal);
        
        const closeBtn = modal.querySelector('#closeModalBtn');
        closeBtn.addEventListener('click', () => {
            modal.remove();
            window.location.href = '/';
        });
        
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.remove();
                window.location.href = '/';
            }
        });
    }
    
    form.addEventListener('submit', (e) => {
        e.preventDefault();
        clearMessage();
        
        const firstName = document.getElementById('firstName').value.trim();
        const lastName = document.getElementById('lastName').value.trim();
        const email = document.getElementById('email').value.trim();
        const subject = document.getElementById('subject').value.trim();
        const message = document.getElementById('message').value.trim();
        
        if (!firstName || !lastName || !email || !subject || !message) {
            showMessage('Prosimo, izpolnite vsa polja.', 'error');
            return;
        }
        
        if (!email.includes('@') || !email.includes('.')) {
            showMessage('Prosimo, vnesite veljaven e-poštni naslov.', 'error');
            return;
        }
        
        if (message.length < 10) {
            showMessage('Sporočilo mora vsebovati vsaj 10 znakov.', 'error');
            return;
        }
        
        submitBtn.disabled = true;
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Pošiljanje...';
        
        setTimeout(() => {
            showSuccessModal();
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            form.reset();
            charCountSpan.textContent = '0';
        }, 1500);
    });
</script>