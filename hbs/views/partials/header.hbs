<nav class="navbar">
    <div class="logo" onclick="window.location.href='/'">
        <div class="logo-icon"><i class="fas fa-hand-peace"></i></div>
        <span class="logo-text">Srečajmo<span>se</span></span>
    </div>
    <div class="nav-buttons">
        {{#if user}}
            <span class="user-greeting">Pozdravljen, {{user.username}}!</span>
            <button class="btn-ghost" onclick="window.location.href='/dashboard'">Nadzorna plošča</button>
            <button class="btn-secondary" onclick="window.location.href='/logout'">Odjava</button>
        {{else if admin}}
            <span class="admin-badge">Admin</span>
            <button class="btn-ghost" onclick="window.location.href='/admin'">Admin panel</button>
            <button class="btn-secondary" onclick="window.location.href='/logout'">Odjava</button>
        {{else}}
            <button class="btn-ghost" onclick="window.location.href='/login'">Prijava</button>
            <button class="btn-primary" onclick="window.location.href='/register'">Registracija</button>
        {{/if}}
    </div>
</nav>